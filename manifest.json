{
  "manifest_version": 3,
  "name": "ReNote",
  "version": "1.0.0",
  "description": "A Chrome extension that allows users to take notes on any webpage and save them for later reference.",
  "icons": {
    "128": "images/icon-128.png"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "128": "images/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"]
    }
  ],
  "permissions": ["storage"]
}




